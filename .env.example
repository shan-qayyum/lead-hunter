# Copy to .env and fill in. .env is git-ignored and loaded automatically by lib.mjs.
# Any OpenAI-compatible chat endpoint (a local Ollama/LM Studio server, a gateway, or a hosted API).
LLM_BASE_URL=http://localhost:11434/v1
# Leave empty for a local server that needs no key.
LLM_API_KEY=
# Optional: port for the web app (default 4818).
LH_PORT=4818
